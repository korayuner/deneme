# KUDEB Panel — Lokal Ortam Değişkenleri
# Kullanım: docker compose -f docker-compose.local.yml --env-file .env.local up -d

# ─── Gemini API (PDF analizi için) ────────────────────────────────────────────
# https://aistudio.google.com adresinden ücretsiz alınır
# Şimdilik boş bırakılabilir — PDF analiz özelliği çalışmaz ama panel açılır
GEMINI_API_KEYS=

# ─── Google Drive (fotoğraf yükleme için — opsiyonel) ────────────────────────
# Şimdilik boş bırak, fotoğraf sekmesi "yapılandırılmamış" mesajı verir
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ─── Paperless Token (ilk çalıştırmadan sonra doldur) ────────────────────────
# Paperless açıldıktan sonra: http://localhost:8000/api/token/
# kullanıcı adı: admin  şifre: kudeb2026
PAPERLESS_TOKEN=
