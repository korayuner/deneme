# ─── KUDEB Panel — Ortam Değişkenleri ─────────────────────────────────────────
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# Ardından değerleri doldurun.

# ─── Gemini API ───────────────────────────────────────────────────────────────
# https://aistudio.google.com adresinden ücretsiz alınır
GEMINI_API_KEYS=AIzaSy...

# ─── Google Drive (fotoğraf entegrasyonu) ─────────────────────────────────────
# Google Cloud Console → Service Account oluştur → JSON anahtar indir
# İndirilen dosyayı google-service-account.json olarak bu klasöre koy
#
# Drive'da "KUDEB Arşivi" klasörü oluştur → klasörün URL'sindeki ID'yi buraya yaz
# Örn: https://drive.google.com/drive/folders/1abc...xyz  →  GOOGLE_DRIVE_ROOT_FOLDER_ID=1abc...xyz
# Service account e-postasını bu klasöre "Düzenleyici" olarak ekle
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ─── Traefik / SSL (docker-compose içinde kullanılıyor, genellikle değiştirilmez) ─
# DOMAIN=kudeb.urla.online
